# Auto-pilot cron secret — protects GET /api/autopilot from public triggers
# Set any random string, then call /api/autopilot?secret=YOUR_SECRET from a cron service
AUTOPILOT_SECRET=your_random_secret

# Rate limiting (hard hourly/daily ceilings)
MAX_EMAILS_PER_HOUR=20
MAX_EMAILS_PER_DAY=100

# Inbox warm-up ramp — protects sender reputation (start low, grow daily)
WARMUP_START=15          # emails allowed on day 1
WARMUP_INCREMENT=10      # +this many per day
WARMUP_MAX=120           # ceiling once fully warmed

# Continuous worker (npm run autopilot)
WORKER_INTERVAL_MIN=45   # ~minutes between cycles
WORKER_START_HOUR=9      # only send 9am–7pm (local, looks human)
WORKER_END_HOUR=19
WORKER_EMAILS_PER_RUN=5  # emails per cycle (spread across the day)
WORKER_EMAIL_DELAY_MS=45000  # ~45s pause between individual sends
